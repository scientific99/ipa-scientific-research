# API URL that the user's browser can reach; embedded into the frontend image at build time.
REACT_APP_API_BASE_URL=http://localhost:9000/api/v1.0

# Generate a unique value for each deployment, for example with:
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET_KEY=replace-this-with-a-random-secret

# Required only for Google Sheets feedback integration.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE_FEEDBACK=Data
# Paste the service-account JSON as a single-line JSON value, enclosed in single quotes.
GOOGLE_SHEET_CREDENTIALS_JSON=
